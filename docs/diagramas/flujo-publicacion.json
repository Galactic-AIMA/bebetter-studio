    {
      "dot": "cyan",
      "title": "Lo que exige el PC encendido",
      "items": [
        "Emparejar, renderizar con FFmpeg y escribir en SQLite",
        "El cron de insights: si el PC estuvo apagado, se recoge al arrancar",
        "Publicar no lo exige, eso ya vive en n8n"
      ]
    },
    {
      "dot": "amber",
      "title": "La cola no es un calendario",
      "items": [
        "El Sheet no guarda una hora futura por pieza",
        "La hora emerge de la posicion en la cola mas la cadencia",
        "El cron corre cada hora y solo actua si toca franja"
      ]
    },
    {
      "dot": "rose",
      "title": "Donde se ha roto",
      "items": [
        "Tres intentos fallidos dejan la fila en needs-attention con aviso",
        "El audio a 96 kHz hacia que Instagram rechazara el reel",
        "Un Sheets read despues de un fan-out multiplica los items del flujo"
      ]
    },
    {
      "dot": "emerald",
      "title": "Que se mide",
      "items": [
        "skip rate y watch time deciden, no el alcance",
        "publications vincula cada media_id con frase, imagen y audio",
