      {
        "id": "04d2851a-db95-4c32-b9ec-c319bd67b591",
        "name": "🎯 Elegir carrusel",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          340,
          300
        ],
        "parameters": {
          "jsCode": "\n// Elige el carrusel `approved` más antiguo sin publicar y explota sus imágenes:\n// devuelve UN item por imagen (el HTTP siguiente corre una vez por item).\nconst rows = $input.all().map(i => i.json)\n  .filter(r => String(r.status).trim() === 'approved' && !String(r.publishedAt || '').trim());\nif (!rows.length) return [];\n\nrows.sort((a, b) => String(a.createdAt).localeCompare(String(b.createdAt)));\nconst row = rows[0];\n\nlet urls = [];\ntry { urls = JSON.parse(row.imageUrls); } catch (e) { urls = []; }\nif (!Array.isArray(urls) || !urls.length) {\n  throw new Error('El carrusel ' + row.id + ' no tiene imageUrls válidas');\n}\nif (urls.length > 10) urls = urls.slice(0, 10);  // límite de Instagram\n\n// Alt text por slide (accesibilidad + señal de búsqueda). Si falta, cae al tema:\n// la Graph API no debe recibir un alt_text vacío.\nlet alts = [];\ntry { alts = JSON.parse(row.altTexts || '[]'); } catch (e) { alts = []; }\n\nreturn urls.map((url, idx) => ({\n  json: {\n    queueId: row.id,\n    carouselId: row.carouselId,\n    tema: row.tema,\n    referencia: row.referencia || '',\n    caption: row.captionIG || '',\n    imageUrl: url,\n    altText: String(alts[idx] || row.tema || 'Carrusel de bebetter').slice(0, 1000),\n    idx,\n    total: urls.length,\n  }\n}));\n"
        }
      },
