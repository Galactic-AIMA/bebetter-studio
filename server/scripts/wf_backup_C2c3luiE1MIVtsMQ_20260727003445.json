      {
        "id": "1dfeb3ca-1664-4fc5-b2ad-5d893ede507e",
        "name": "📦 Juntar children",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          940,
          300
        ],
        "parameters": {
          "jsCode": "\n// Agrega los N container ids (uno por imagen) en la lista `children`.\nconst items = $input.all();\nconst ids = items.map(i => i.json.id).filter(Boolean);\nconst meta = $('🎯 Elegir carrusel').first().json;\n\nif (ids.length !== meta.total) {\n  throw new Error('Se crearon ' + ids.length + ' de ' + meta.total + ' contenedores');\n}\nreturn [{ json: {\n  children: ids.join(','),\n  queueId: meta.queueId,\n  carouselId: meta.carouselId,\n  tema: meta.tema,\n  referencia: meta.referencia,\n  caption: meta.caption,\n  total: meta.total,\n} }];\n"
        }
