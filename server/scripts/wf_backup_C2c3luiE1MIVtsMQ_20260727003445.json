    {
      "id": "cacce810-f7c9-43b9-b560-c132db3b0e76",
      "name": "🕐 ¿Toca ahora?",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -60,
        300
      ],
      "parameters": {
        "jsCode": "\n// ¿Toca publicar carrusel en esta hora? Cadencia semanal: días ISO + horas.\nconst cfg = {};\nfor (const it of $input.all()) {\n  if (it.json.key) cfg[String(it.json.key).trim()] = String(it.json.value ?? '').trim();\n}\nconst tz = cfg.timezone || 'America/Bogota';\nconst days = (cfg.carousel_cadence_days || '2,5').split(',')\n  .map(s => parseInt(s.trim(), 10)).filter(n => n >= 1 && n <= 7);\nconst hours = (cfg.carousel_cadence_times || '19:00').split(',')\n  .map(s => parseInt(String(s).split(':')[0], 10)).filter(n => n >= 0 && n <= 23);\n\nconst now = new Date();\nconst f = new Intl.DateTimeFormat('en-US', {\n  timeZone: tz, hour12: false, weekday: 'short', hour: '2-digit'\n});\nconst parts = {};\nfor (const p of f.formatToParts(now)) parts[p.type] = p.value;\nconst map = { Mon: 1, Tue: 2, Wed: 3, Thu: 4, Fri: 5, Sat: 6, Sun: 7 };\nconst isoDay = map[parts.weekday];\nconst hour = parseInt(parts.hour, 10);\n\nif (!days.includes(isoDay) || !hours.includes(hour)) return [];\nreturn [{ json: { ok: true, isoDay, hour, tz } }];\n"
      }
    },
