# ─── Cloudflare R2 ────────────────────────────────────────
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Formato: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_BUCKET=
# URL pública del bucket (dominio personalizado o https://pub-<hash>.r2.dev)
R2_PUBLIC_URL=

# ─── Server ───────────────────────────────────────────────
PORT=3001
CLIENT_URL=http://localhost:5173

# ─── Paths ────────────────────────────────────────────────
# Ruta absoluta a tu banco de imágenes local
IMAGES_PATH=C:/Users/David/Documents/bebetter/Imagenes de referencia
# Carpeta donde se guardan los videos generados
OUTPUT_PATH=./output
# Ruta a la carpeta de fuentes personalizadas
FONTS_PATH=./data/fonts
# Ruta a la carpeta de pistas de audio de fondo (royalty-free)
AUDIO_PATH=./data/audio

# ─── n8n Webhooks ─────────────────────────────────────────
WEBHOOK_TEST_URL=https://n8n.galacticaima.com/webhook-test/videopublish
WEBHOOK_PROD_URL=https://n8n.galacticaima.com/webhook/videopublish
# Secreto de autenticación del webhook (header x-galactic-auth).
# n8n rechaza con 403 las llamadas sin este valor. Pedir el valor a David.
WEBHOOK_SECRET=

# ─── App ──────────────────────────────────────────────────
# URL pública de esta app (para generar links directos a videos locales)
# Ejemplo: http://localhost:3001 en dev, o https://tudominio.com en prod
PUBLIC_BASE_URL=http://localhost:3001

# ─── Pinterest ────────────────────────────────────────────
# Crear app en: https://developers.pinterest.com
# Redirect URI de la app: http://localhost:4322
# Scopes requeridos: boards:read, pins:read, offline_access
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_BOARD_ID=
PINTEREST_CREDENTIALS_PATH=./credentials/pinterest-token.json

# ─── IA: Google (AI Studio + Vertex) ──────────────────────
# Clave de AI Studio. Tier `paid` para contenido propio.
GOOGLE_API_KEY=
# Clave de un proyecto SIN billing = capa gratuita. Trabajo a granel (banco de
# imagenes, audio, analisis del nicho). Google entrena con lo que pase por aqui:
# nunca contenido propio.
GOOGLE_API_KEY_FREE=

# Vertex AI — ensayo de creditos (alta 2026-08-17, corte 2026-11-15).
# Con VERTEX_PROJECT o VERTEX_CREDENTIALS vacios se cae a AI Studio: ese es el
# rollback, sin tocar codigo.
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
# Ruta al JSON de la service account. DEJARLA VACIA en Cloud Run / GCE: sin
# keyFile, google-auth-library usa las credenciales de la SA adjunta (ADC).
# En la VM de AWS si hace falta el archivo, montado como secreto — nunca horneado
# en la imagen del contenedor.
VERTEX_CREDENTIALS=./credentials/vertex-service-account.json
# Los modelos 3.x (texto e imagen) SOLO responden en `global`, no en us-central1.
VERTEX_TEXT_LOCATION=global
VERTEX_IMAGE_LOCATION=global
VERTEX_IMAGE_MODEL=gemini-3-pro-image

# Backend de imagenes IA: 'kie' (revendedor, cobra por imagen) o 'vertex'.
IMAGE_BACKEND=vertex
KIE_API_KEY=

# ─── Fuentes ──────────────────────────────────────────────
# Las sirve la app en /api/fonts y las pinta FFmpeg: es el MISMO archivo, y de
# eso depende que el corte de linea del servidor coincida con el del preview.
# Se generan con `python scripts/download-fonts.py --force`.
FONTS_PATH=../data/fonts
