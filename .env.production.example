# Plantilla del .env de PRODUCCIÓN (la VM de AWS).
#
#   cp .env.production.example .env   y rellenar.
#
# ⚠️ Este fichero NO entra en la imagen (ver .dockerignore): el compose lo lee con
# `env_file` en tiempo de ejecución. Un secreto horneado viaja a donde viaje la
# imagen y no se rota sin reconstruir.
#
# Las variables que el compose ya fija por su cuenta —DATABASE_URL, DB_ENGINE,
# PUBLIC_BASE_URL, CLIENT_URL, FONTS_PATH, WATERMARK_PATH, OUTPUT_PATH,
# IMAGES_PATH, AUDIO_PATH, VERTEX_CREDENTIALS, NODE_ENV, PORT— NO van aquí.
# Ponerlas otra vez solo sirve para que un día discrepen.

# ─── Postgres (lo consume el compose para construir DATABASE_URL) ────────────
POSTGRES_USER=bebetter
POSTGRES_DB=bebetter
# Genera una y no la reutilices de ningún otro sitio:  openssl rand -base64 32
POSTGRES_PASSWORD=

# ─── Caddy / TLS ─────────────────────────────────────────────────────────────
# Correo al que Let's Encrypt avisa si un certificado va a caducar sin renovarse.
# Va aquí y no en el Caddyfile porque el repo es público.
ACME_EMAIL=

# ─── La puerta (tapón hasta que exista el Google OAuth) ──────────────────────
# La app NO tiene autenticación propia. Sin esto, el dominio queda abierto a
# quien lo encuentre — y aparece en los logs de Certificate Transparency en
# cuanto Caddy emite el certificado.
# El hash se genera con:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'TU_CLAVE'
#
# ⚠️ HAY QUE DOBLAR LOS `$` DEL HASH. Un bcrypt tiene la forma `$2a$14$xxxx…`, y
# Docker Compose interpreta cada `$` como el principio de una variable: el hash
# se convertiría en tres variables vacías y Caddy arrancaría con la puerta rota,
# avisando solo con un `warning` que es fácil pasar por alto. En este fichero
# `$$` significa un `$` literal, así que el valor va así:
#     BASIC_AUTH_HASH=$$2a$$14$$xxxxxxxxxxxx…
BASIC_AUTH_USER=david
BASIC_AUTH_HASH=

# ─── Cloudflare R2 — el banco y las piezas renderizadas ──────────────────────
# ⚠️ Rotar la clave antes de desplegar: está pendiente desde el 2026-08-19.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_URL=

# ─── n8n ─────────────────────────────────────────────────────────────────────
WEBHOOK_TEST_URL=https://n8n.galacticaima.com/webhook-test/videopublish
WEBHOOK_PROD_URL=https://n8n.galacticaima.com/webhook/videopublish
WEBHOOK_APPROVAL_URL=
WEBHOOK_SECRET=

# ─── IA ──────────────────────────────────────────────────────────────────────
# AI Studio, tier de pago: contenido propio.
GOOGLE_API_KEY=
# Proyecto SIN billing = capa gratuita, para trabajo a granel.
# Google entrena con lo que pase por aquí: nunca contenido propio.
GOOGLE_API_KEY_FREE=

# Vertex. Con VERTEX_PROJECT vacío se cae a AI Studio: ese es el rollback.
VERTEX_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_TEXT_LOCATION=global
VERTEX_IMAGE_LOCATION=global
VERTEX_IMAGE_MODEL=gemini-3-pro-image
VERTEX_IMAGE_MODEL_FALLBACK=gemini-2.5-flash-image
# El JSON de la service account va en ./credentials/vertex-service-account.json
# y el compose lo monta. NO se hornea.

IMAGE_BACKEND=vertex
KIE_API_KEY=

# Reparto de fondos IA/banco (80/20 desde el 2026-08-18).
IA_PRIMERO=true
IA_PROPORCION=0.8

# ─── Google Sheets / Drive (cola de publicación de la Fase 4) ────────────────
GOOGLE_SHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_OAUTH_CREDENTIALS_PATH=/app/credentials/google-oauth.json
GOOGLE_OAUTH_TOKEN_PATH=/app/credentials/google-token.json

# ─── Pinterest ───────────────────────────────────────────────────────────────
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
PINTEREST_BOARD_ID=
PINTEREST_CREDENTIALS_PATH=/app/credentials/pinterest-token.json

# ─── Apify (Fase 5, análisis del nicho) ──────────────────────────────────────
APIFY_TOKEN=

# ─── Lo que NO se pone en la VM ──────────────────────────────────────────────
# GALLERY_DL_PATH / YTDLP_* : la cosecha de audio se queda SIEMPRE en local.
# yt-dlp contra Instagram desde una IP de datacenter se bloquea mucho más que
# desde una residencial, y la dispara David pegando links. Solo viaja el
# resultado, que sube a R2 como una pista más.
